import fs from 'node:fs';
import path from 'node:path';

import {
  defineConfig,
  loadEnv
} from 'vite';

const touch = (file) => {
  fs.closeSync(fs.openSync(path.resolve(__dirname, file), 'w'))
};

const remove = (file) => {
  if (fs.existsSync(path.resolve(__dirname, file))) {
    fs.rmSync(path.resolve(__dirname, file));
  }
};

export default defineConfig(({ command, mode }) => {
  const {
    APP_URL = 'http://localhost'
  } = process.env;

  const {
    VITE_HOST = '0.0.0.0',
    VITE_PORT = 5173
  } = loadEnv(mode, process.cwd());

  switch (command) {
    case 'serve':
      touch('site/cache/.vite-server');

      process.on('exit', () => remove('site/cache/.vite-server'));
      process.on('SIGINT', () => process.exit());
      process.on('SIGTERM', () => process.exit());
      process.on('SIGHUB', () => process.exit());
      break;
  }

  return {
    base: mode === 'development' ? '/' : '/assets/build',
    publicDir: false,
    resolve: {
      alias: {
        '@': path.resolve(__dirname, 'site/assets')
      }
    },
    build: {
      outDir: path.resolve(__dirname, 'assets/build'),
      sourcemap: true,
      manifest: true,
      rollupOptions: {
        input: [
          path.resolve(__dirname, 'site/assets/css/index.css'),
          path.resolve(__dirname, 'site/assets/js/index.js')
        ],
        output: {
          entryFileNames: '[name]-[hash].js',
          chunkFileNames: '[name]-[hash].js',
          assetFileNames: '[name]-[hash][extname]'
        }
      }
    },
    server: {
      host: VITE_HOST,
      port: VITE_PORT,
      origin: APP_URL,
      strictPort: true
    }
  };
});
