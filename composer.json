{
  "name": "hksagentur/kirby-vite",
  "description": "Vite integration for Kirby",
  "type": "kirby-plugin",
  "license": "ISC",
  "authors": [
    {
      "name": "Daniel Weidner",
      "email": "d.weidner@hks-agentur.de",
      "homepage": "https://hks-agentur.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Hks\\Vite\\": "src/"
    }
  },
  "require": {
    "getkirby/composer-installer": "^1.1"
  },
  "require-dev": {
    "laravel/pint": "^1.25"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "installer-name": "vite"
  },
  "scripts": {
    "format": [
      "pint -v"
    ],
    "lint": [
      "pint -v --test"
    ]
  }
}
